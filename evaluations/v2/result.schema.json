{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hcu-desktop-automation.invalid/evaluations/v2/result.schema.json",
  "title": "Dynamic UI RPA V2 evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "case_id",
    "split",
    "condition",
    "synthetic",
    "started_at",
    "platform",
    "client",
    "model",
    "skill_version",
    "engine_profile",
    "task_success",
    "agent_claimed_success",
    "independent_verifier",
    "evidence_level",
    "metrics",
    "recovery",
    "error_codes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "development",
        "validation",
        "holdout"
      ]
    },
    "condition": {
      "enum": [
        "A",
        "B",
        "C"
      ]
    },
    "synthetic": {
      "type": "boolean"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "platform": {
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "client": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "skill_version": {
      "type": "string",
      "minLength": 1
    },
    "engine_profile": {
      "enum": [
        "browser_only",
        "desktop_only",
        "hybrid"
      ]
    },
    "task_success": {
      "type": "boolean"
    },
    "agent_claimed_success": {
      "type": "boolean"
    },
    "independent_verifier": {
      "type": "string",
      "minLength": 1
    },
    "evidence_level": {
      "enum": [
        "L1",
        "L2",
        "L3"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_calls",
        "browser_calls",
        "desktop_calls",
        "auxiliary_calls",
        "browser_snapshots",
        "browser_screenshots",
        "desktop_ax_calls",
        "desktop_gui_calls",
        "input_tokens",
        "output_tokens",
        "wall_time_ms",
        "handoff_latency_ms",
        "duplicate_mutations"
      ],
      "properties": {
        "model_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "browser_calls": {
          "type": "integer",
          "minimum": 0
        },
        "desktop_calls": {
          "type": "integer",
          "minimum": 0
        },
        "auxiliary_calls": {
          "type": "integer",
          "minimum": 0
        },
        "browser_snapshots": {
          "type": "integer",
          "minimum": 0
        },
        "browser_screenshots": {
          "type": "integer",
          "minimum": 0
        },
        "desktop_ax_calls": {
          "type": "integer",
          "minimum": 0
        },
        "desktop_gui_calls": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "integer",
          "minimum": 0
        },
        "handoff_latency_ms": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "duplicate_mutations": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible",
        "recovered",
        "safe_stopped",
        "failed"
      ],
      "properties": {
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "recovered": {
          "type": "integer",
          "minimum": 0
        },
        "safe_stopped": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "error_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
